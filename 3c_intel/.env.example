# ====== 复制本文件为 .env 并填入真实值 ======

# 企业微信群机器人 Webhook 的 key（必填，否则无法推送）
# 完整地址形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=XXXX
# 这里只填 key= 后面的部分
WECHAT_WEBHOOK_KEY=

# OpenAI 配置（可选，不填则使用本地模板生成简报）
OPENAI_API_KEY=
# 可选：自定义 API 网关 / 代理地址，例如 https://your-proxy/v1
OPENAI_BASE_URL=
# 可选：模型名，默认 gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# 定时执行时间（schedule 方式使用），格式 HH:MM，默认 08:00
SCHEDULE_TIME=08:00
